{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "anvc",
  "version": "0.4.10",
  "identifier": "com.anvc.worklog",
  "build": {
    "frontendDist": "../desktop",
    "beforeDevCommand": "bun scripts/desktop-sidecar.ts",
    "beforeBuildCommand": "bun scripts/desktop-sidecar.ts"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/anvc-server"
    ]
  }
}
